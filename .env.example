# Which LLM powers the "Ask my agent" chat: google (default, free tier) | anthropic | openai
AI_PROVIDER=google

# Only the key for the provider you pick is required.
# Gemini (free): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Claude: https://console.anthropic.com (billed separately from a claude.ai plan)
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com
OPENAI_API_KEY=

# Optional: override the default model (gemini-2.5-flash / claude-haiku-4-5 / gpt-4o-mini)
AI_MODEL=

# Chat rate limits (optional; these are the defaults)
CHAT_LIMIT_PER_MINUTE=5
CHAT_LIMIT_PER_DAY=40
CHAT_LIMIT_GLOBAL_PER_DAY=800

# Optional: Upstash Redis makes rate limits shared across all serverless instances
# (recommended on Vercel). Free tier: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact form email via Resend (free tier: https://resend.com). Without a key the form opens the visitor's mail app.
RESEND_API_KEY=
# Optional: where messages go (defaults to the portfolio email) and the sender (needs a domain verified in Resend)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Your deployed URL. Used for SEO metadata, the sitemap, OG images and the chat API's origin check.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
